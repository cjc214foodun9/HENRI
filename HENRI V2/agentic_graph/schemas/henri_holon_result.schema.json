{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "henri.holon-result.v1",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "status",
    "claim_status",
    "finding",
    "proposed_changes",
    "evidence_refs",
    "verification_requests",
    "assumptions",
    "risks",
    "next_action",
    "usage",
    "claim"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "failed",
        "budget_exhausted"
      ]
    },
    "claim_status": {
      "enum": [
        "verified",
        "supported",
        "inferred",
        "unverified"
      ]
    },
    "finding": {
      "type": "string"
    },
    "proposed_changes": {
      "type": "array"
    },
    "evidence_refs": {
      "type": "array"
    },
    "verification_requests": {
      "type": "array"
    },
    "assumptions": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "next_action": {
      "enum": [
        "accept",
        "repair_leaf",
        "request_input",
        "block",
        "defer"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "statement",
        "evidence_status"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "evidence_status": {
          "enum": [
            "verified",
            "supported",
            "inferred",
            "unverified"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
