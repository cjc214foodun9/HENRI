  "ctor_body::opine_object_mcts.py": [
   "13: class OPINEObjectMCTS(torch.nn.Module):",
   "14:     \"\"\"Groups primitive action steps into temporal macro-options over",
   "15:     su(3)^num_channels. Default-OFF additive component; never changes the",
   "16:     production EFE control arm unless explicitly wired behind a flag.\"\"\"",
   "17: ",
   "18:     def __init__(self, num_channels: int = 8192, option_horizon: int = 4):",
   "19:         super().__init__()",
   "20:         self.num_channels = num_channels",
   "21:         self.option_horizon = option_horizon",
   "22: ",
   "23:     def construct_macro_option(",
   "24:         self, generator_sequence: list,",
   "25:         device: str | None = None,",
   "26:     ) -> torch.Tensor:",
   "27:         \"\"\"Compose a sequence of [3,3] complex Lie generators into one",
   "28:         [num_channels, 3, 3] unitary macro-operator.",
   "29: ",
   "30:         generator_sequence: list of [3,3] complex matrices (su(3) Lie",
   "31:             elements, i.e. i * sum_k theta_k lambda_k). The same generator is",
   "32:             applied to every channel (channel-homogeneous option); the",
   "33:             composite is SU(3) in each channel when each exp(gen) is SU(3).",
   "34:         Returns: [num_channels, 3, 3] composite unitary (det 1 per channel).",
   "35:         \"\"\"",
   "36:         dev = device or (",
   "37:             generator_sequence[0].device if generator_sequence else \"cpu\")",
   "38:         composite_u = torch.eye(",
   "39:             3, dtype=torch.complex64, device=dev",
   "40:         ).repeat(self.num_channels, 1, 1)",
   "41:         for gen in generator_sequence:",
   "42:             u_step = torch.matrix_exp(gen.to(dev)).unsqueeze(0)",
   "43:             composite_u = torch.einsum(",
   "44:                 \"nij,njk->nik\", composite_u, u_step.expand(",
   "45:                     self.num_channels, 3, 3))",
   "46:         return composite_u",
   "47: ",
   "48:     def unitarity_error(self, macro_option: torch.Tensor) -> float:",
   "49:         \"\"\"Mean ||U U^dag - I||_F over channels (G1-8.22 metric).\"\"\"",
   "50:         diff = (",
   "51:             torch.einsum(\"nij,nkj->nik\", macro_option, macro_option.conj())",
   "52:             - torch.eye(3, dtype=macro_option.dtype,",
   "53:                         device=macro_option.device).unsqueeze(0)"
  ],
