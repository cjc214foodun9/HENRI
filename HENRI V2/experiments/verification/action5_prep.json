   "93: class SU3FieldWaveTransducer(torch.nn.Module):",
   "94:     \"\"\"Bijective, gauge-invariant transducer connecting SU(3)^N Lie group fields",
   "95:     to complex unit hypervectors on S^(D-1) (D = N*8).",
   "96: ",
   "97:     Spec: HENRI-SPEC-2026-08-PHASE8.18-TRANSDUCER (SHA 158c02c7...).",
   "98:     Deviations applied (see experiments/sweeps/phase818_transducer_design.md):",
   "99:     D19 eigendecomposition matrix log (torch.linalg.matrix_log absent on",
   "100:     torch 2.12.0+cu130 \u2014 VERIFIED local + remote); D20 corrected projection",
   "101:     einsum 'aij,bnji->bna' (spec 'abc,bncb->bna' has a b-index collision);",
   "102:     D21 corrected reconstruction einsum 'bna,aij->bnij' (spec 'bna,abc->bnabc'",
   "103:     never contracts the generator index).",
   "104:     \"\"\"",
   "105: ",
   "106:     def __init__(self, gell_mann_basis: torch.Tensor):",
   "107:         super().__init__()",
   "108:         basis = gell_mann_basis.detach().clone()",
   "109:         self.register_buffer(\"basis\", basis)  # [8, 3, 3] complex",
   "110: ",
   "111:     @staticmethod",
   "112:     def _matrix_log(U: torch.Tensor) -> torch.Tensor:",
   "113:         \"\"\"Matrix log for unitary U via eigendecomposition (D19).\"\"\"",
   "114:         evals, evecs = torch.linalg.eig(U)",
   "115:         return (evecs @ torch.diag_embed(torch.log(evals)) @ evecs.conj().transpose(-2, -1)).to(U.dtype)",
   "116: ",
   "117:     def field_to_wave(self, su3_field: torch.Tensor) -> torch.Tensor:",
   "118:         \"\"\"su3_field: [B, N, 3, 3] complex SU(3). Returns [B, N*8] complex",
   "119:         unit-modulus wave hypervector on S^(D-1).\"\"\"",
   "120:         B, N, _, _ = su3_field.shape",
   "121:         log_u = self._matrix_log(su3_field)                  # [B, N, 3, 3]",
   "122:         algebra = (-1j * log_u).to(self.basis.dtype)         # su(3) Hermitian, c64",
   "123:         theta = 0.5 * torch.real(",
   "124:             torch.einsum(\"aij,bnji->bna\", self.basis, algebra)",
   "125:         )                                                    # [B, N, 8]",
   "126:         return torch.exp(1j * theta.reshape(B, N * 8)).to(self.basis.dtype)",
   "127: ",
   "128:     def wave_to_field(self, wave_vector: torch.Tensor) -> torch.Tensor:",
   "129:         \"\"\"wave_vector: [B, D] complex unit hypervector. Returns [B, D//8, 3, 3]",
   "130:         complex SU(3) matrices.\"\"\"",
   "131:         B, D = wave_vector.shape",
   "132:         N = D // 8",
   "133:         theta = torch.angle(wave_vector).reshape(B, N, 8)",
   "134:         alg = (1j * torch.einsum(",
   "135:             \"bna,aij->bnij\", theta.to(self.basis.dtype), self.basis",
   "136:         )).to(self.basis.dtype)                               # [B, N, 3, 3] c64",
   "137:         return torch.matrix_exp(alg)",
   "138: ",
   "139:     def round_trip_error(self, su3_field: torch.Tensor) -> torch.Tensor:",
   "140:         \"\"\"Mean per-block round-trip ||U - Phi^-1(Phi(U))||_F (G1-8.18 metric).\"\"\"",
   "141:         w = self.field_to_wave(su3_field)",
   "142:         rec = self.wave_to_field(w)",
   "143:         return (su3_field - rec).norm(dim=(-2, -1)).mean()",
   "144: ",
   "145: ",
   "146: if __name__ == \"__main__\":",
   "147:     udt = UniversalDataTransducer(d_model=65536)",
   "148:     wave = udt.transduce_string(\"hello henri\")",
   "149:     print(f\"Transduced string wave shape: {wave.shape}, dtype: {wave.dtype}\")"
  ],
