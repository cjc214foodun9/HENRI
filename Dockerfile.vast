# HENRI V2 Execution Runtime (Vast.ai)
# Start from the official PyTorch CUDA image. This avoids installing the large
# CUDA/PyTorch wheel stack over SSH on a fresh Vast instance.
# Zone C is a separate native PostgreSQL service with persistent storage.
FROM pytorch/pytorch:2.12.0-cuda13.0-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONPATH="/workspace/HENRI/HENRI V2" \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# OS utilities and build tools. The base image already provides Python,
# CUDA, and PyTorch; do not replace those runtime components here.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl wget ca-certificates \
        openssh-server rsync tmux htop \
        build-essential cmake \
    && rm -rf /var/lib/apt/lists/*

# Copy the dependency manifest before installation, then copy the committed
# release tree. Credentials, checkpoints, telemetry, local databases, and
# benchmark task data are excluded by repository policy.
COPY requirements.txt /workspace/HENRI/requirements.txt

# The base image supplies the CUDA-enabled PyTorch runtime. Install the
# repository dependency contract without replacing that wheel with a CPU build.
RUN python -m pip install --upgrade pip setuptools wheel \
    && grep -v '^torch[<=>]' /workspace/HENRI/requirements.txt > /tmp/henri-requirements-no-torch.txt \
    && python -m pip install -r /tmp/henri-requirements-no-torch.txt \
    && python -m pip install triton==3.7.1

COPY . /workspace/HENRI

# Client only. The image does not install or start PostgreSQL. Native Zone C
# setup is handled by scripts/zone_c_install_native.sh and
# scripts/zone_c_bootstrap.py on the host that owns the persistent database.
RUN apt-get update && apt-get install -y --no-install-recommends \
        postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*

# SSH for Vast.ai & environment setup
RUN mkdir -p /var/run/sshd \
    && echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config \
    && echo 'X11Forwarding yes' >> /etc/ssh/sshd_config

WORKDIR /workspace/HENRI/HENRI V2

EXPOSE 22 8000

CMD ["/bin/bash"]
