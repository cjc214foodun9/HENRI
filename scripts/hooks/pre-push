#!/bin/sh
# D6 gate-first promotion hook (versioned template; NOT active until enabled).
#
# A LOCAL hook is not a CI gate. It protects this clone only. It does not
# protect a merge performed elsewhere, and it can be bypassed with --no-verify.
# Real enforcement requires a server-side / CI check.
#
# ENABLE (one line, absolute path, repo-wide):
#   git config core.hooksPath "C:/Users/chan/henri-worktrees/phase1-transduction/scripts/hooks"
# DISABLE:
#   git config --unset core.hooksPath
#
# COST: the fast gate set takes roughly 1-3 minutes per push.
set -u
REPO="C:/Users/chan/henri-worktrees/phase1-transduction"
echo "[pre-push] running D6 gate-first check..."
python "$REPO/scripts/prepush_gate.py" --quiet
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "[pre-push] BLOCKED: a gate failed (rc=$rc)."
  echo "[pre-push] manifest: $REPO/design/zone_a/evidence/prepush_gate_manifest.json"
  echo "[pre-push] Do not bypass with --no-verify unless a human approves."
  exit 1
fi
echo "[pre-push] all gates green."
exit 0
